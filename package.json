{
  "name": "living-region",
  "version": "0.1.0",
  "description": "Open-source map-based regional metabolism simulator for land use, housing, roads, food, energy, population, and local services.",
  "type": "module",
  "scripts": {
    "demo": "node command/run_demo.mjs",
    "demo:no-adaptation": "node command/run_demo_no_adaptation.mjs",
    "demo:compare": "node command/run_demo_compare.mjs",
    "demo:inspect": "node command/run_demo_inspect.mjs",
    "demo:rail": "node command/run_demo_rail.mjs",
    "demo:grey": "node command/run_grey_county_seed.mjs",
    "demo:grey:rail": "node command/run_grey_county_seed.mjs --rail=true",
    "demo:grey:full": "node command/run_grey_county_seed.mjs --scale=full-county",
    "demo:grey:rail:full": "node command/run_grey_county_seed.mjs --rail=true --scale=full-county",
    "demo:grey:compare-food": "node command/run_grey_compare_food.mjs",
    "demo:grey:inspect": "node command/run_grey_county_seed_inspect.mjs",
    "demo:grey:rail:inspect": "node command/run_grey_county_seed_inspect.mjs --rail=true",
    "demo:compare-rail": "node command/run_demo_compare_rail.mjs",
    "demo:compare-calibration": "node command/run_demo_compare_calibration.mjs",
    "sensitivity:rail": "node command/run_sensitivity.mjs",
    "scenario:manifest": "node command/run_scenario_manifest.mjs",
    "export:metrics": "node command/export_metrics.mjs",
    "export:geojson": "node command/export_demo_geojson.mjs",
    "import:region": "node command/import_region.mjs",
    "demo:imported": "node command/run_imported_scenario.mjs",
    "seed:grey": "node command/generate_grey_county_seed.mjs",
    "seed:grey:rail": "node command/generate_grey_county_seed.mjs --rail=true",
    "seed:grey:county-lite": "node command/generate_grey_county_seed.mjs --scale=county-lite",
    "seed:grey:medium": "node command/generate_grey_county_seed.mjs --scale=medium --rail=true --water=true",
    "seed:grey:full": "node command/generate_grey_county_seed.mjs --scale=full-county",
    "seed:grey:full:rail": "node command/generate_grey_county_seed.mjs --scale=full-county --rail=true --water=true",
    "seed:grey:open-data": "node command/seed_grey_open_data.mjs",
    "demo:grey:open-data": "node command/run_grey_open_data.mjs",
    "report:grey:baseline": "node command/report_grey_baseline.mjs",
    "report:grey:secondary": "node command/report_grey_secondary.mjs",
    "report:grey:public-baseline": "node command/report_grey_public_baseline.mjs",
    "report:grey:land-access": "node command/report_grey_land_access.mjs",
    "report:grey:labour-land": "node command/report_grey_labour_land_baseline.mjs",
    "report:grey:food-calibration": "node command/report_grey_food_calibration.mjs",
    "report:grey:localization-access": "node command/report_grey_localization_access.mjs",
    "report:grey:population-distribution": "node command/report_grey_population_distribution.mjs",
    "report:grey:dwelling-land-access": "node command/report_grey_dwelling_land_access.mjs",
    "report:grey:farm-labour": "node command/report_grey_farm_labour_baseline.mjs",
    "report:grey:ag-labour": "node command/report_grey_ag_labour_baseline.mjs",
    "report:grey:current-shock-threshold": "node command/report_grey_current_system_shock_threshold.mjs",
    "report:grey:fuel-shock": "node command/report_grey_fuel_fertilizer_shock.mjs",
    "report:grey:transition-pathways": "node command/report_grey_transition_pathways.mjs",
    "report:grey:briefing": "node command/report_grey_briefing.mjs",
    "report:grey:all": "node command/run_grey_report_suite.mjs",
    "report:carrying-capacity": "node command/report_carrying_capacity.mjs",
    "report:grey:carrying-capacity": "node command/report_grey_carrying_capacity.mjs",
    "report:grey:household-transition": "node command/report_grey_household_transition.mjs",
    "build:carrying-capacity-contract": "node command/build_carrying_capacity_presentation.mjs",
    "build:carrying-capacity-web": "npm run build:carrying-capacity-contract && vite build --config packages/education-web/vite.config.ts && node packages/education-web/scripts/write-pages-artifacts.mjs",
    "dev:education": "npm run build:carrying-capacity-contract && vite --config packages/education-web/vite.config.ts",
    "build:education": "npm run build:carrying-capacity-web",
    "validate:education": "node packages/education-web/scripts/validate-contract.mjs",
    "report:model:assessment": "node command/report_living_region_assessment.mjs",
    "grey:open-data": "node command/grey_open_data.mjs",
    "grey:discover-data": "node command/discover_grey_open_data.mjs",
    "grey:discover-all-data": "node command/discover_all_grey_data.mjs",
    "grey:download-data": "node command/download_grey_open_data.mjs --all",
    "grey:download-roads": "node command/download_grey_roads.mjs",
    "grey:import-data": "node command/import_grey_open_data.mjs",
    "census:download-2021": "node command/download_canada_census_2021.mjs",
    "census:import-grey-population": "node command/import_grey_census_population.mjs",
    "census-ag:download-2021": "node command/download_census_agriculture_2021.mjs",
    "census-ag:import-grey": "node command/import_grey_census_agriculture.mjs",
    "census-pop-labour:download-2021": "node command/download_census_population_labour_2021.mjs",
    "census-pop-labour:import-grey": "node command/import_grey_census_population_labour.mjs",
    "grey:import-roads": "node command/import_grey_roads.mjs",
    "grey:summarize-gis": "node command/summarize_grey_gis.mjs",
    "grey:data-status": "node command/grey_data_status.mjs",
    "grey:status": "node command/grey_status.mjs",
    "check:food-energy-terms": "node command/check_food_energy_terms.mjs",
    "test": "npm run test:unit && npm run test:carrying-capacity",
    "test:unit": "vitest run",
    "test:carrying-capacity": "npm run test --workspace=@living-region/carrying-capacity",
    "report:grey:food-gap-replacement": "node command/report_grey_food_gap_replacement.mjs",
    "report:grey:food-price": "node command/report_grey_food_supply_demand_price.mjs",
    "report:grey:food-insecurity-trends": "node command/report_grey_food_insecurity_trends.mjs",
    "report:grey:food-insecurity-trend": "node command/report_grey_food_insecurity_trend_projection.mjs",
    "report:grey:hormuz-article-data": "node command/report_grey_hormuz_food_security_article_data.mjs",
    "report:article-support": "node command/report_article_support_evidence_packet.mjs",
    "report:local-calibration": "node command/report_local_calibration_summary.mjs",
    "report:land-access-groundtruth": "node command/report_land_access_groundtruth.mjs",
    "report:gis-inventory-bridge": "node command/bridge_existing_gis_to_land_access_contracts.mjs",
    "qa": "node command/qa_reliability.mjs",
    "rebuild:all": "node command/rebuild_all.mjs",
    "release:article-data": "node command/release_article_data.mjs",
    "demo:owen-sound": "tsx packages/data-pipeline/src/cli/demo-owen-sound.ts",
    "discover:sites": "tsx packages/data-pipeline/src/cli/discover-sites.ts",
    "score:sites": "tsx packages/data-pipeline/src/cli/score-sites.ts",
    "prepare:site": "tsx packages/data-pipeline/src/cli/prepare-site.ts",
    "export:web": "tsx packages/data-pipeline/src/cli/export-web.ts",
    "dev:web": "vite --config packages/web-client/vite.config.ts",
    "build:web": "vite build --config packages/web-client/vite.config.ts",
    "validate": "tsx packages/data-pipeline/src/cli/validate.ts",
    "validate:systemic-energy": "tsx packages/systemic-energy-adapter/src/cli/validate.ts",
    "validate:all": "npm run validate && npm run validate:systemic-energy",
    "osm:download": "node command/download_osm_extract.mjs --region ontario --cache-dir data/osm --out data/osm/ontario-latest.osm.pbf",
    "osm:prepare:owen-sound": "node command/prepare_osm_extract.mjs --input data/osm/ontario-latest.osm.pbf --boundary data/boundaries/owen-sound.geojson --out data/osm/owen-sound.osm.pbf",
    "osm:compare:owen-sound": "node command/compare_osm_intersections.mjs --osm-pbf data/osm/owen-sound.osm.pbf --boundary data/boundaries/owen-sound.geojson --out artifacts/osm-intersection-comparison.pya",
    "osm:compare:with-download": "node command/compare_osm_intersections_with_download.mjs --boundary data/boundaries/owen-sound.geojson --cache-dir data/osm --out artifacts/osm-intersection-comparison.pya",
    "osm:boundary:owen-sound": "node command/export_owen_sound_boundary.mjs",
    "docker:web:build": "docker compose build hamlet-web",
    "docker:web:up": "docker compose up -d hamlet-web",
    "docker:web:logs": "docker compose logs -f hamlet-web",
    "transit:plan:owen-sound": "tsx packages/transit-planner/src/cli/plan-owen-sound.ts",
    "canvassing:acquire-buildings": "tsx packages/canvassing/src/acquire-building-data.ts",
    "canvassing:extract-city-roofs": "python3 scripts/extract_owen_sound_city_map_buildings.py",
    "canvassing:prepare": "tsx packages/canvassing/src/prepare-data.ts",
    "canvassing:prepare-osm-import": "tsx packages/canvassing/src/prepare-osm-import.ts",
    "canvassing:verify-operations": "tsx packages/canvassing/src/verify-operations.ts",
    "canvassing:repair-journal": "tsx packages/canvassing/src/repair-journal.ts",
    "test:e2e:canvassing": "playwright test --config=playwright.canvassing.config.ts",
    "canvassing:server": "tsx packages/canvassing/src/server.ts",
    "canvassing:dev": "npm run canvassing:prepare && concurrently -k -n api,web \"npm run canvassing:server\" \"npm run dev:web\""
  },
  "keywords": [
    "regional-planning",
    "gis",
    "simulation",
    "resilience",
    "land-use",
    "transportation",
    "food-systems",
    "energy",
    "housing",
    "open-data",
    "grey-county"
  ],
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/three": "^0.185.0",
    "concurrently": "^9.2.4",
    "playwright": "^1.62.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/liberit/living-region.git"
  },
  "bugs": {
    "url": "https://gitlab.com/liberit/living-region/-/issues"
  },
  "homepage": "https://gitlab.com/liberit/living-region",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "pdf-parse": "^1.1.1",
    "polygon-clipping": "^0.15.7",
    "three": "^0.171.0"
  }
}
