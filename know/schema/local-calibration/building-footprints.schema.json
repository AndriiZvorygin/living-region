{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Land Access Building Footprints Calibration",
  "type": "object",
  "required": [
    "building_id",
    "municipality",
    "centroid_latitude",
    "centroid_longitude",
    "footprint_area_m2",
    "building_type",
    "source_ref",
    "quality_tier",
    "notes"
  ],
  "properties": {
    "building_id": { "type": "string", "minLength": 1 },
    "municipality": { "type": "string", "minLength": 1 },
    "centroid_latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "centroid_longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "footprint_area_m2": { "type": "number", "exclusiveMinimum": 0 },
    "building_type": { "type": "string", "minLength": 1 },
    "source_ref": { "type": "string", "minLength": 1 },
    "quality_tier": {
      "type": "string",
      "enum": [
        "direct_local",
        "regional_proxy",
        "provincial_proxy",
        "national_proxy",
        "scenario_only",
        "unknown"
      ]
    },
    "notes": { "type": "string" }
  }
}
