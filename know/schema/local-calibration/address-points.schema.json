{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Land Access Address Points Calibration",
  "type": "object",
  "required": [
    "address_id",
    "civic_address",
    "municipality",
    "latitude",
    "longitude",
    "source_ref",
    "quality_tier",
    "notes"
  ],
  "properties": {
    "address_id": { "type": "string", "minLength": 1 },
    "civic_address": { "type": "string", "minLength": 1 },
    "municipality": { "type": "string", "minLength": 1 },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "source_ref": { "type": "string", "minLength": 1 },
    "quality_tier": {
      "type": "string",
      "enum": [
        "direct_local",
        "regional_proxy",
        "provincial_proxy",
        "national_proxy",
        "scenario_only",
        "unknown"
      ]
    },
    "notes": { "type": "string" }
  }
}
