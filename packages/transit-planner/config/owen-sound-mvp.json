    "osm_pbf": "data/osm/owen-sound.osm.pbf",
    "population_blocks": "know/produce/grey-census-population-blocks.geojson",
    "public_facilities": "know/input/gis/public-facilities.geojson",
    "forbidden": ["know/input/gis/grey-transit-routes.geojson"]
  },
  "output_dir": "know/produce/transit-network-mvp",
  "projection": "local equirectangular metres centred on Owen Sound",
  "bus": {
    "default_speed_kph_by_road_class": {
      "1": 50,
      "2": 50,
      "3": 40,
      "4": 35,
      "5": 30,
      "6": 25,
      "default": 30
    },
    "speed_cap_kph": 50,
    "road_class_penalty_seconds_per_km": {
      "1": 0,
      "2": 0,
      "3": 8,
      "4": 18,
      "5": 30,
      "6": 55,
      "default": 35
    },
    "intersection_penalty_seconds": 3,
    "turn_penalty_seconds": 7,
    "sharp_turn_penalty_seconds": 12,
    "left_turn_major_road_penalty_seconds": 18,
    "major_road_classes": [1, 2, 3],
    "stop_dwell_seconds": 20,
    "terminal_layover_minutes": 5,
    "service_span_hours": 14,
    "stop_spacing_target_m": 400,
    "stop_spacing_min_m": 300,
    "stop_spacing_max_m": 550,
    "route_circuitry_warning_ratio": 1.45
  },
  "walking": {
    "speed_kph": 4.5,
    "coverage_thresholds_m": [300, 400, 600],
    "population_snap_limit_m": 180,
    "allowed_highways": ["footway", "path", "pedestrian", "steps", "living_street", "residential", "service", "unclassified", "tertiary", "secondary", "primary", "trunk"]
  },
  "demand_model": {
    "average_passengers_per_loop": 7,
    "stop_events_per_passenger": 2,
    "shared_stop_event_factor": 0.72,
    "low_usage_factor": 0.55,
    "minimum_used_stops": 2,
    "method": "Expected unique active stops from effective board/alight events distributed across scheduled stops; low case scales expected use; high case assumes every scheduled stop is used."
  },
  "scoring_weights": {
    "access_population_400m": 0.3,
    "major_destinations_direct": 0.15,
    "directness": 0.15,
    "frequency_feasibility": 0.15,
    "reliability": 0.1,
    "operating_efficiency": 0.1,
    "low_duplication": 0.05
  },
  "hill_line": {
    "id": "hill-line-primary",
