:80 {
	encode zstd gzip

	@canvassing_app path /canvassing /canvassing/
	header @canvassing_app Cache-Control "no-cache, must-revalidate"
	@canvassing_manifest path /canvassing/manifest.json
	header @canvassing_manifest Cache-Control "no-cache, must-revalidate"
	@canvassing_data {
		path /canvassing/*.json /canvassing/*.geojson
		not path /canvassing/manifest.json
	}
	header @canvassing_data Cache-Control "public, max-age=31536000, immutable"
	# The canvassing UI is a pathname-selected SPA entry point. The public
	# /canvassing directory also contains data assets, so an implicit directory
	# lookup can otherwise serve the root Yurt Hamlet index instead of the
	# canvassing bootstrap document.
	rewrite @canvassing_app /index.html

	handle /api/* {
		reverse_proxy canvassing-api:4174 {
			header_up Authorization "Bearer docker-private-canvassing"
		}
	}

	root * /srv/hamlet
	handle {
		try_files {path} /index.html
		file_server
	}
}
